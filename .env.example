
# ==============================================
# Configuration pour Grottocenter AI Tools
# ==============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ==============================================
# API Configuration
# ==============================================
API_HOST=127.0.0.1
API_PORT=8000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ==============================================
# Streamlit Configuration  
# ==============================================
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# ==============================================
# Grottocenter API Configuration
# ==============================================
# URL de base de l'API Grottocenter
GROTTOCENTER_URL=https://api.grottocenter.org/api/v1/

# Token d'authentification Grottocenter
# IMPORTANT: Remplacez par votre token personnel
GROTTOCENTER_TOKEN=

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=INFO


REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_CONCURRENCY=2

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=fra+eng+spa+deu+ita

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=300
LLM_MAX_TEXT_CHARS=50000
OLLAMA_CTX=8192
OLLAMA_NUM_PREDICT=1024