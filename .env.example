# GreenPT API
GREENPT_API_URL=https://api.greenpt.ai/v1
GREENPT_API_KEY=
SSO_SALT_DOCUMENTS=

# HTTP
# Browser origins allowed to call the API, comma-separated. Never `*`.
# Local front development origins are set in docker-compose.dev.yml, not here.
CORS_ORIGINS=https://grottocenter.org
# Also allow a developer's machine (localhost, 127.0.0.1 and [::1], any port, http or https).
CORS_ALLOW_LOCALHOST=false
# Also allow origins matching this regular expression, against the whole origin, for the staging
# deployments. Write it with [0-9] and [.] instead of \d and \., which survive a .env file.
# Example: https://orange-rock-0d4f87503-[0-9]+[.]westeurope[.]azurestaticapps[.]net
# A pattern that would match an unrelated site (such as .*) stops the server from starting.
CORS_ORIGIN_REGEX=
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# Reverse proxies whose X-Forwarded-For uvicorn trusts (the Traefik address in production)
FORWARDED_ALLOW_IPS=127.0.0.1
# Host port the API is published on by the compose files
AI_SERVER_PORT=8000

# Cost and abuse limits. Anyone with a Grottocenter account may analyse and sign-up is open,
# so these protect the GreenPT bill. GLOBAL_DAILY_LIMIT is a placeholder until the price of
# one analysis is known.
ANALYZE_ENABLED=true
USER_DAILY_LIMIT=5
USER_MAX_CONCURRENT=2
GLOBAL_DAILY_LIMIT=200
MAX_FILE_SIZE_MB=50
MAX_PAGES=300
MAX_LLM_CALLS=10
# Grottocenter user ids with no daily quota, comma-separated (for example 1,60181). Empty means
# nobody. They still count toward GLOBAL_DAILY_LIMIT and keep the concurrency, size and page
# limits and the kill switch.
QUOTA_EXEMPT_USER_IDS=

# MongoDB
# Choose your own passwords, e.g. `openssl rand -hex 24`. Use URL-safe characters only
# (hex is safest): the application password is embedded in the MongoDB connection URI,
# so `/`, `+`, `=`, `@` or `:` in it would break the connection. Never commit real values.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=grottocenter_app
MONGO_APP_PASSWORD=
MONGO_DB_NAME=grottocenter
