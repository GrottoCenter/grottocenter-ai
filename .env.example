# GreenPT API
GREENPT_API_URL=https://api.greenpt.ai/v1
GREENPT_API_KEY=
SSO_SALT_DOCUMENTS=

# HTTP
# Browser origins allowed to call the API, comma-separated. Never `*`.
# Local front development origins are set in docker-compose.dev.yml, not here.
CORS_ORIGINS=https://grottocenter.org
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
# Reverse proxies whose X-Forwarded-For uvicorn trusts (the Traefik address in production)
FORWARDED_ALLOW_IPS=127.0.0.1

# MongoDB
# Choose your own passwords, e.g. `openssl rand -base64 24`. Never commit real values.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=grottocenter_app
MONGO_APP_PASSWORD=
MONGO_DB_NAME=grottocenter

# Cost and abuse limits. Anyone with a Grottocenter account may analyse and sign-up is open,
# so these protect the GreenPT bill. GLOBAL_DAILY_LIMIT is a placeholder until the price of
# one analysis is known.
ANALYZE_ENABLED=true
USER_DAILY_LIMIT=5
USER_MAX_CONCURRENT=2
GLOBAL_DAILY_LIMIT=200
MAX_FILE_SIZE_MB=50
MAX_PAGES=300
MAX_LLM_CALLS=10
